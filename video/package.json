{
  "name": "abot-cinematic-video",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "audio": "node scripts/generate-audio.mjs",
    "render": "remotion render src/remotion-root.tsx ABOTCinematic ../deliverables/ABOT_Cinematic_Demo.mp4 --codec=h264 --audio-codec=aac --image-format=jpeg --overwrite"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.0",
    "@remotion/renderer": "^4.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remotion": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.3"
  }
}
