# --- Supabase (service-role key is server-only; never expose to the client) ---
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_with_service_role_key

# --- Admin / automation auth ---
# Bearer token required on every state-changing API route (payouts, agent run, fund).
ADMIN_API_TOKEN=replace_with_a_long_random_token
# Optional: if set, Vercel Cron Jobs can trigger /api/agent/run with Authorization: Bearer $CRON_SECRET
CRON_SECRET=

# --- Noir (Stellar Testnet, @noirx402/agent-sdk) ---
# Server-side secret for ABOT's autonomous agent key. Never ship this to the browser.
AGENT_SECRET=replace_with_agent_stellar_secret_key
AGENT_PUBLIC_KEY=replace_with_agent_stellar_public_key
# Device whose Noir escrow funds payouts when a request doesn't name one explicitly.
ORG_DEVICE_HASH=replace_with_64_char_hex_device_hash
# Optional override; defaults to the SDK's built-in public Testnet RPC.
NOIR_RPC_URL=

# --- Velo (@carts1024/velo-sdk@alpha) ---
VELO_API_KEY=tk_test_replace_me
VELO_WEBHOOK_SECRET=replace_with_webhook_signing_secret
VELO_ENVIRONMENT=testnet
VELO_BASE_URL=
VELO_FUNDING_ASSET=USDC

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
